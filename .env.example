# Copie para .env e preencha. NUNCA commite o .env com valores reais.
# Os valores reais ficam fora do git (gerenciador de senhas / canal privado).

# --- Banco (Postgres). Com o túnel SSH de pé: DB_HOST=localhost, DB_PORT=5434
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Multitenant / autenticação
DEFAULT_TENANT_ID=
AUTH_SECRET=
AUTH_URL=
AUTH_TRUST_HOST=

# --- n8n (webhooks e API)
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_TOKEN=
N8N_API_KEY=
N8N_API_KEY_GERAL=

# --- Base pública do app (callback enviado ao n8n; em dev use um túnel)
APP_BASE_URL=

# --- MinIO (arquivos). Com o túnel de pé: MINIO_ENDPOINT=http://localhost:9000
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=
